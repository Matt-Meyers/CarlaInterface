  </socket>
  <socket client="a2j" exclusive="off" name="a2j Impulse cap 1" type="jack-midi">
   <plug>Impulse\ \(capture\)\:\ Impulse\ \ Impulse\ </plug>
  </socket>
  <socket client="a2j" exclusive="off" name="a2j KX8 1 cap" type="jack-midi">
   <plug>YAMAHA\ KX\ \(capture\)\:\ YAMAHA\ KX\ MIDI\ 1</plug>
  </socket>
