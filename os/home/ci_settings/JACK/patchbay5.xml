<!DOCTYPE patchbay>
<patchbay name="patchbay5" version="0.9.6">
 <output-sockets>
  <socket name="kbd-midi.py" exclusive="off" client="a2j" type="jack-midi">
   <plug>RtMidiOut\ Client\ \(capture\)\:\ Python\ GUI\ MIDI\ Debugger</plug>
  </socket>
  <socket name="PulseAudio\ JACK\ Sink 1" exclusive="off" client="PulseAudio\ JACK\ Sink" type="jack-audio">
   <plug>front\-left</plug>
  </socket>
  <socket name="PulseAudio\ JACK\ Sink 2" exclusive="off" client="PulseAudio\ JACK\ Sink" type="jack-audio">
   <plug>front\-right</plug>
  </socket>
  <socket name="system 1" exclusive="off" client="system" type="jack-audio">
   <plug>capture_1</plug>
  </socket>
  <socket name="a2j casio cap" exclusive="off" client="a2j" type="jack-midi">
   <plug>Keyboard\ \(capture\)\:\ Keyboard\ CASIO\ USB\ IN</plug>
  </socket>
  <socket name="a2j Impulse cap 1" exclusive="off" client="a2j" type="jack-midi">
   <plug>Impulse\ \(capture\)\:\ Impulse\ \ Impulse\ </plug>
  </socket>
  <socket name="a2j KX8 1 cap" exclusive="off" client="a2j" type="jack-midi">
   <plug>YAMAHA\ KX\ \(capture\)\:\ YAMAHA\ KX\ MIDI\ 1</plug>
  </socket>
  <socket name="a2j korg nano" exclusive="off" client="a2j" type="jack-midi">
   <plug>nanoKONTROL\ \(capture\)\:\ nanoKONTROL\ nanoKONTROL\ _\ CTRL</plug>
  </socket>
  <socket name="carla audio out 1" exclusive="off" client="Carla" type="jack-audio">
   <plug>audio\-out1</plug>
  </socket>
  <socket name="carla audio out 2" exclusive="off" client="Carla" type="jack-audio">
   <plug>audio\-out2</plug>
  </socket>
 </output-sockets>
 <input-sockets>
  <socket name="ffmpeg_grab 1" exclusive="off" client="grab" type="jack-audio">
   <plug>input_1</plug>
  </socket>
  <socket name="ffmpeg_grab 2" exclusive="off" client="grab" type="jack-audio">
   <plug>input_2</plug>
  </socket>
  <socket name="Carla 1" exclusive="off" client="Carla" type="jack-midi">
   <plug>events\-in</plug>
  </socket>
  <socket name="system playback 1" exclusive="off" client="system" type="jack-audio">
   <plug>playback_1</plug>
  </socket>
  <socket name="system playback 2" exclusive="off" client="system" type="jack-audio">
   <plug>playback_2</plug>
  </socket>
 </input-sockets>
 <slots/>
 <cables>
  <cable output="PulseAudio\ JACK\ Sink 1" input="system playback 1" type="jack-audio"/>
  <cable output="PulseAudio\ JACK\ Sink 2" input="system playback 2" type="jack-audio"/>
  <cable output="a2j casio cap" input="Carla 1" type="jack-midi"/>
  <cable output="a2j Impulse cap 1" input="Carla 1" type="jack-midi"/>
  <cable output="a2j KX8 1 cap" input="Carla 1" type="jack-midi"/>
  <cable output="a2j korg nano" input="Carla 1" type="jack-midi"/>
  <cable output="carla audio out 1" input="system playback 1" type="jack-audio"/>
  <cable output="carla audio out 1" input="ffmpeg_grab 1" type="jack-audio"/>
  <cable output="carla audio out 2" input="system playback 2" type="jack-audio"/>
  <cable output="carla audio out 2" input="ffmpeg_grab 2" type="jack-audio"/>
  <cable output="kbd-midi.py" input="Carla 1" type="jack-midi"/>
 </cables>
</patchbay>

