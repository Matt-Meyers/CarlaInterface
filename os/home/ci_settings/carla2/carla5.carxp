 <!-- sfizz -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>sfizz Gogodze Drums</Name>
   <URI>http://sfztools.github.io/sfizz</URI>
  </Info>

  <Data>
   <Active>No</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x3f0</Options>

   <Parameter>
    <Index>0</Index>
    <Name>Volume</Name>
    <Symbol>volume</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>1</Index>
    <Name>Polyphony</Name>
    <Symbol>num_voices</Symbol>
    <Value>64</Value>
   </Parameter>

   <Parameter>
    <Index>2</Index>
    <Name>Oversampling factor</Name>
    <Symbol>oversampling</Symbol>
    <Value>1</Value>
   </Parameter>

   <Parameter>
    <Index>3</Index>
