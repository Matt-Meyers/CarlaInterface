<!DOCTYPE patchbay>
<patchbay version="0.9.6" name="patchbay5">
 <output-sockets>
  <socket client="PulseAudio\ JACK\ Sink" exclusive="off" name="PulseAudio\ JACK\ Sink 1" type="jack-audio">
   <plug>front\-left</plug>
  </socket>
  <socket client="PulseAudio\ JACK\ Sink" exclusive="off" name="PulseAudio\ JACK\ Sink 2" type="jack-audio">
   <plug>front\-right</plug>
  </socket>
  <socket client="system" exclusive="off" name="system 1" type="jack-audio">
   <plug>capture_1</plug>
  </socket>
  <socket client="a2j" exclusive="off" name="a2j casio cap" type="jack-midi">
