   <plug>audio\-out2</plug>
  </socket>
 </output-sockets>
 <input-sockets>
  <socket client="grab" exclusive="off" name="ffmpeg_grab 1" type="jack-audio">
   <plug>input_1</plug>
  </socket>
  <socket client="grab" exclusive="off" name="ffmpeg_grab 2" type="jack-audio">
   <plug>input_2</plug>
  </socket>
  <socket client="Carla" exclusive="off" name="Carla 1" type="jack-midi">
   <plug>events\-in</plug>
  </socket>
  <socket client="system" exclusive="off" name="system playback 1" type="jack-audio">
   <plug>playback_1</plug>
  </socket>
  <socket client="system" exclusive="off" name="system playback 2" type="jack-audio">
   <plug>playback_2</plug>
  </socket>
 </input-sockets>
 <slots/>
 <cables>
  <cable type="jack-audio" output="PulseAudio\ JACK\ Sink 1" input="system playback 1"/>
  <cable type="jack-audio" output="PulseAudio\ JACK\ Sink 2" input="system playback 2"/>
  <cable type="jack-midi" output="a2j casio cap" input="Carla 1"/>
  <cable type="jack-midi" output="a2j Impulse cap 1" input="Carla 1"/>
  <cable type="jack-midi" output="a2j KX8 1 cap" input="Carla 1"/>
  <cable type="jack-midi" output="a2j korg nano" input="Carla 1"/>
  <cable type="jack-audio" output="carla audio out 1" input="system playback 1"/>
  <cable type="jack-audio" output="carla audio out 1" input="ffmpeg_grab 1"/>
  <cable type="jack-audio" output="carla audio out 2" input="system playback 2"/>
  <cable type="jack-audio" output="carla audio out 2" input="ffmpeg_grab 2"/>
 </cables>
</patchbay>

